{
  "id": "com.shinorkon.gradingcoach",
  "name": "Grading Coach",
  "shortname": "gradingcoach",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["https://directors-eye.shinorkon.com"]
    }
  },
  "entrypoints": [
    {
      "id": "gradingcoachpanel",
      "type": "panel",
      "minimumSize": { "width": 320, "height": 400 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 380, "height": 520 },
      "preferredFloatingSize": { "width": 380, "height": 520 },
      "label": {
        "default": "Grading Coach"
      }
    }
  ]
}
